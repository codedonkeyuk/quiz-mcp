{
  "name": "ts-mcp-tools",
  "version": "0.0.1",
  "description": "A simple ts library for use as a template",
  "license": "MIT",
  "author": "Leigh",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "workspaces": [
    "mcp-packages/*",
    "mcp-servers/*"
  ],
  "scripts": {
    "clean": "npx prettier . --write",
    "validate": "npx prettier . --check && tsc --noEmit && npx cspell \"**/*README*.md\"",
    "serve": "node src/index.ts",
    "test": "npm test --workspaces --if-present && node --experimental-strip-types --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "prettier": "3.9.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  }
}
